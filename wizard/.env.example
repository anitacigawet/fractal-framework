# Fractal Framework Wizard - local self-hosted configuration
#
# All keys are optional at boot. You can set them here, or save them at
# runtime through the Settings page (which writes to ./data/settings.json).
# Env vars take precedence over the settings file.
#
# Pick ONE active provider - you only need a key for the provider you select
# for the intake chat. The NotebookLM bridge has its own auth; run
# `notebooklm login` once after installing the bridge dependencies.

# Active LLM provider for the intake chat (gemini | openai | deepseek).
# Default is Google Gemini.
LLM_PROVIDER=gemini

# --- Google Gemini -----------------------------------------------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI ------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- DeepSeek ----------------------------------------------------
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Google Stitch (generative per-campaign visual design) -------
# Optional. When configured, the Campaign page exposes a "Generate with
# Stitch" button that designs custom visual chrome for each campaign's
# generated site. When unset, the wizard falls back to its default
# template — the campaign is still fully usable. Stitch is free to use
# with a Google account.
#
# Get a key by signing in at https://stitch.withgoogle.com/ and following
# the developer-access flow. The SDK README at
# https://github.com/google-labs-code/stitch-sdk has the latest details.
STITCH_API_KEY=
# Which Gemini model Stitch uses to generate designs.
# GEMINI_3_FLASH = faster / cheaper (default)
# GEMINI_3_PRO   = slower / higher fidelity
STITCH_MODEL=GEMINI_3_FLASH

# --- Framework Notebook ------------------------------------------
# The NotebookLM notebook the wizard uses for the "Pick for me" flow.
# Created automatically by clicking "Set up Framework Notebook" on the
# Settings page; this env var lets you pin a specific notebook ID instead
# (useful for sharing across machines or for testing).
FRAMEWORK_NOTEBOOK_ID=

# Python command used to run the NotebookLM bridge. Leave blank to use `py`
# on Windows or `python3` on macOS/Linux. Set an absolute virtual-environment
# interpreter path when needed.
BRIDGE_PYTHON=

# Maximum intake-provider requests per second. 0 disables this optional delay.
RATE_LIMIT_RPS=0

# --- Storage / server --------------------------------------------

# Where the SQLite database file lives (auto-created on first run)
DATABASE_PATH=./data/wizard.db

# Where the user-editable settings JSON file lives
SETTINGS_PATH=./data/settings.json

# Wizard backend port. The server always binds to 127.0.0.1 so API keys and
# local campaign data are not exposed to other devices on the network. The
PORT=7101
